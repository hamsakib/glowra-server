# Copy to .env and fill in.
NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/glowra locally)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/glowra?retryWrites=true&w=majority
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
# Frontend origin(s), comma separated. "*.vercel.app" allows preview deployments.
CLIENT_ORIGIN=http://localhost:3000
# Public URL of this API (used for uploaded image links)
PUBLIC_API_URL=http://localhost:5000
